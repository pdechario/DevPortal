{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["ES2022"],
    "outDir": "dist",
    "rootDir": "src",
    "baseUrl": "./",
    "declaration": true,
    "sourceMap": true,
    "incremental": true,
    // Must live inside outDir. nest-cli.json sets deleteOutDir, which wipes
    // dist/ before compiling; if the buildinfo survives outside it, tsc
    // believes the output is current and emits nothing while exiting 0.
    "tsBuildInfoFile": "dist/.tsbuildinfo",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "strictPropertyInitialization": false,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
